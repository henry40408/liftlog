# CI passes the version in as GIT_VERSION; excluding .git stops every commit
# from invalidating the `COPY . .` layer and the build behind it.
.git
.github

# Browser tests: a separate Go module that never ships in the image.
e2e

# README images, generated by e2e/cmd/screenshots.
screenshots/

# Local build output and data.
bin
*.sqlite3
*.sqlite3-*
.env
